<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow (bottom-right) -->
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/shadowDark" />
        </shape>
    </item>

    <!-- Highlight (top-left) -->
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/shadowLight" />
        </shape>
    </item>

    <!-- Card surface -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/surfaceCard" />
        </shape>
    </item>
</layer-list>
